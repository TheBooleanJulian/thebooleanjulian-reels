{
  // The studio's interface at https://reels-editor.thebooleanjulian.dev: static files only (web/build.py copies the
  // page and its fonts into web/dist). Editing, footage and rendering stay on each device, in studio.py.
  // Deploy from main: npx wrangler deploy   (runs the build first)
  "name": "tbj-reels-editor",
  "account_id": "c580c4403524273d1bece674117472dd",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "build": { "command": "python web/build.py" },
  "assets": { "directory": "./web/dist" },
  "routes": [{ "pattern": "reels-editor.thebooleanjulian.dev", "custom_domain": true }]
}
